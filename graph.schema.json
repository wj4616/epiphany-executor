{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "goatcs-harness native graph schema",
  "type": "object",
  "required": [
    "schema_version",
    "dialect",
    "skill_name",
    "skill_version",
    "determinism_class",
    "nodes",
    "edges",
    "entrypoints"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "dialect": {
      "const": "native"
    },
    "skill_name": {
      "type": "string"
    },
    "skill_version": {
      "type": "string"
    },
    "determinism_class": {
      "enum": [
        "deterministic",
        "non-deterministic"
      ]
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tier": {
            "enum": [
              "no-llm",
              "model-small",
              "model-medium",
              "model-large"
            ]
          },
          "exec_type": {
            "enum": [
              "inline",
              "spawn"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "src",
          "dst",
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "back-edge",
              "forward-conditional",
              "gate-open",
              "optional",
              "required",
              "terminal"
            ]
          }
        }
      }
    },
    "templates": {
      "type": "object"
    }
  },
  "additionalProperties": true
}